<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Process Escort Request -->
	<!-- Trigger for Command received WW2EscortRequest -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-ProcessEscortRequest</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:CommandReceived]
			[CommandReceiveCode:WW2EscortRequest]
			
			[StartsReady:true]
			[MinCooldownMs:0]
			[MaxCooldownMs:0]
			[MaxActions:-1]
			
            [Actions:WW2-Action-ProcessEscortRequest]
			
			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-ProcessEscortRequest</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]
			
			[AssignEscortFromCommand:true]
			
			</Description>
        </EntityComponent>
<!-- End Process Escort Request -->

	</EntityComponents>
</Definitions>