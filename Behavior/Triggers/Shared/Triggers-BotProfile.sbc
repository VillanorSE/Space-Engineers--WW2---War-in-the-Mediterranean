<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-BotSpawnProfile-CombatBot</SubtypeId>
            </Id>
            <Description>
			
			[MES Bot Spawn]
			
			[BotDisplayName:Soldier]
			[Color:{X:100 Y:100 Z:100}]
			
			[BotType:Target_Dummy]
			[BotBehavior:SOLDIER]
			[UseAiEnabled:true]
			
			[CanUseLadders:true]
			[CanUseSeats:true]
			
			[IgnoreCombatPhase:true]
			
			</Description>
        </EntityComponent>

	</EntityComponents>
</Definitions>