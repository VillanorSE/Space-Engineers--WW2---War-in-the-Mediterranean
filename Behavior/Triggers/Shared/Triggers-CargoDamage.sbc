<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Cargo Damage -->
	<!--Damage received excluding Grind, Weld, Environment, Deformation, or Fire -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-CargoDamage</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:Damage]
			[DamageTypes:Any]
			[ExcludedDamageTypes:Grind]
			[ExcludedDamageTypes:Weld]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Deformation]
			[ExcludedDamageTypes:Fire]
			[MinCooldownMs:30000]
			[MaxCooldownMs:45000]
			[MaxActions:3]
			
            [Actions:WW2-Action-CargoDamage]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-CargoDamage</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-CargoDamage]
			
			</Description>
        </EntityComponent>

	<!-- Chats complaining about damage -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Chat-CargoDamage</SubtypeId>
            </Id>
            <Description>

			[RivalAI Chat]
			
			[UseChat:true]
            [StartsReady:true]
            [BroadcastRandomly:true]
			[Author:{GridName}]
			[Color:Red]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:2000]

            [ChatMessages:Cease this attack!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]
			
			[ChatMessages:We've taken hits!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]
			
			[ChatMessages:They've hit us!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]
			
			[ChatMessages:Why can't they just put some guns on this damn thing!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]
			
			[ChatMessages:Watch it lads, we're getting clapped!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]
			
			[ChatMessages:Third time this week!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]
			
			[ChatMessages:Huh, we've been hit and I'm not even dead yet.]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]
			
			[ChatMessages:Turns out {PlayerName} can actually land a shot.]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]

			</Description>
        </EntityComponent>
<!-- End Cargo Damage -->

	</EntityComponents>
</Definitions>