<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Air Destination -->
	<!-- Triggers when plane receives a command broadcast -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-CargoPlane-Destination</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:CommandReceived]
			[CommandReceiveCode:CargoPlane-DestinationReceived]
			
			[StartsReady:true]
			[MaxActions:1]
            [Actions:WW2-Action-CargoPlane-Destination]
			
			</Description>
        </EntityComponent>

	<!-- Adds waypoint from command, Changes Autopilot -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-CargoPlane-Destination</SubtypeId>
            </Id>
            <Description>	
			
			[RivalAI Action]
			
			[AddWaypointFromCommand:true]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-CargoPlane-Destination]
			
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]

			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-CargoPlane-DestinationReached]
			
			</Description>			
        </EntityComponent>
		
	<!-- Broadcasts chat with 3km range -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Chat-CargoPlane-Destination</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Chat]
			
			[UseChat:true]
			[StartsReady:true]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Cargo Plane Pilot]
			[Color:Blue]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			
			[ChatMessages: This is {AntennaName} requesting clearance for supply drop-off.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			
			[ChatMessages:{AntennaName} approaching the base.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			
			[ChatMessages:Special delivery coming in.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

			</Description>			
        </EntityComponent>
<!-- End Air Destination -->

<!-- Destination Reached -->
	<!-- Triggers when a cargo plane reaches its destination after receiving one from command code -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-CargoPlane-DestinationReached</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]
			
			[UseTrigger:false]
			[Type:BehaviorTriggerA]
			[StartsReady:true]

			[MaxActions:1]
            [Actions:WW2-Action-CargoPlane-DestinationReached]

			</Description>
        </EntityComponent>

	<!-- Activates a Command Profile -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-CargoPlane-DestinationReached</SubtypeId>
            </Id>
            <Description>			

			[RivalAI Action]
			
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:WW2-Command-DestinationReached]
			[ForceDespawn:true]

			</Description>			
        </EntityComponent>

	<!-- Broadcasts Command "WW2-IHaveArrived" with 300m range -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Command-DestinationReached</SubtypeId>
            </Id>
            <Description>			

			[RivalAI Command]
			
			[CommandCode:WW2-IHaveArrived]
			[SingleRecipient:true]
			[SendWaypoint:false]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[MaxRadius:1000]

			</Description>			
        </EntityComponent>
<!-- End Destination Reached -->

	</EntityComponents>
</Definitions>