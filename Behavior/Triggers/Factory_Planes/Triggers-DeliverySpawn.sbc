<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Spawn sequence for a Gray cargo plane -->
	<!-- Triggers Every 30-45 Minutes -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DeliverySpawn-Factory-Plane-Gray</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			
			[MaxActions:-1]
			[MinCooldownMs:1800000]
			[MaxCooldownMs:2700000]
			
            [Actions:WW2-Action-DeliverySpawn-Factory-Plane-Gray]
			
			</Description>
        </EntityComponent>

	<!-- Activates a Rival AI spawn -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DeliverySpawn-Factory-Plane-Gray</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]
			
			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-DeliverySpawn-Factory-Plane-Gray]
			
			</Description>
        </EntityComponent>

	<!-- Spawns a cargo plane 30-45km away -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-DeliverySpawn-Factory-Plane-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]
			
			[SpawnGroups:NPC-WW2-Ju52]
			
			[UseRelativeSpawnPosition:false]
			[MinDistance:30000]
			[MaxDistance:45000]
			[MinAltitude:500]
			[MaxAltitude:1200]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]
			
			</Description>
        </EntityComponent>
<!-- End Spawn sequence for a Gray cargo plane -->

<!-- Spawn sequence for a Green cargo plane -->
	<!-- Triggers Every 30-45 Minutes -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DeliverySpawn-Factory-Plane-Green</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			
			[MaxActions:-1]
			[MinCooldownMs:1800000]
			[MaxCooldownMs:2700000]
			
            [Actions:WW2-Action-DeliverySpawn-Factory-Plane-Green]
			
			</Description>
        </EntityComponent>

	<!-- Activates a Rival AI spawn -->		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DeliverySpawn-Factory-Plane-Green</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]
			
			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-DeliverySpawn-Factory-Plane-Green]
			
			</Description>
        </EntityComponent>

	<!-- Spawns a cargo plane 30-45km away -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-DeliverySpawn-Factory-Plane-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:NPC-WW2-F222]
			
			[UseRelativeSpawnPosition:false]
			[MinDistance:30000]
			[MaxDistance:45000]
			[MinAltitude:400]
			[MaxAltitude:1200]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]
			
			</Description>
        </EntityComponent>
<!-- End Spawn sequence for a Green cargo plane -->

	</EntityComponents>
</Definitions>