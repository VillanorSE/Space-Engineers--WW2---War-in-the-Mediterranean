<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Announcement Action -->
	<!--Triggers 1 second after spawn-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Announcement-Factory</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			
			[MaxActions:1]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]

            [Actions:WW2-Action-Announcement-Factory]
			
			</Description>
        </EntityComponent>
	
	<!-- Broadcasts a chat -->	
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-Announcement-Factory</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-Announcement-Factory]
			
			</Description>
        </EntityComponent>

	<!--Chats a random message announcing a factory is deployed-->		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Chat-Announcement-Factory</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Chat]
			
			[UseChat:true]
            [StartsReady:true]
            [BroadcastRandomly:true]
			[Author:{GridName}]
			[Color:Blue]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:60000]

            [ChatMessages:Another factory brought online!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]

			[ChatMessages:Production is ramping up!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]

            [ChatMessages:Factory to HQ, ready to start production!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]
			
			</Description>
        </EntityComponent>				
<!-- End Announcement Action -->

	</EntityComponents>
</Definitions>