<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Call to Cargo Planes to give them a destination sequence -->

	<!-- Triggers every 30 seconds -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-CallCargoPlane</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:Timer]

			[MinCooldownMs:30000]
			[MaxCooldownMs:30001]
			[StartsReady:true]
        
			[MaxActions:-1]
			[Actions:WW2-Action-CallCargoPlane]
			
			</Description>
		</EntityComponent>

	<!-- Calls a command profile -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-CallCargoPlane</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Action]

			[BroadcastCommandProfiles:true]
			[CommandProfileIds:WW2-Command-CallCargoPlane]
			
			</Description>
		</EntityComponent>
	
	<!-- Sends command code with waypoint, one same-faction receiver -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Command-CallCargoPlane</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Command]

			[CommandCode:CargoPlane-DestinationReceived]
			[SingleRecipient:false]
			[SendWaypoint:true]
			[MatchSenderReceiverOwners:true]
			[Waypoint:WW2-Waypoint-CallCargoPlane]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:50000]
			
			</Description>
		</EntityComponent>

	<!-- Waypoint near Installation -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Waypoint-CallCargoPlane</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Waypoint]

			[Waypoint:EntityRandom]
			[RelativeEntity:Self]
			[MinDistance:60]
			[MaxDistance:101]
			[MinAltitude:150]
			[MaxAltitude:250]
			
			</Description>
		</EntityComponent>
<!-- End Call to Cargo Planes Action -->

	</EntityComponents>
</Definitions>