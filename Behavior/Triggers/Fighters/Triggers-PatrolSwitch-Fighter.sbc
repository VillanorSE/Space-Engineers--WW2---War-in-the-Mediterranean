<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Trigger to switch to patrol behavior when target outside of 6km -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-PatrolSwitch-Fighter</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:false]
			[Type:TargetFar]
			[TargetDistance:6000]
			
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-PatrolSwitch-Fighter]
			
			</Description>
        </EntityComponent>

	<!-- Action switches behavior to Patrol and primary autopilot, turns on combat behavior triggers, turns off patrol trigger -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-PatrolSwitch-Fighter</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-PatrolSwitch-Fighter]

			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Patrol]

			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]

			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-PatrolSwitch-Fighter]

			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-LowAltitudeFighting]
			[EnableTriggerNames:WW2-Trigger-HighAltitudeFighting]
			[EnableTriggerNames:WW2-Trigger-FighterSwitch-Fighter]

			</Description>
        </EntityComponent>
	
	<!-- Broadcasts chats about patrolling -->	
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Chat-PatrolSwitch-Fighter</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]

			[UseChat:true]
			[StartsReady:true]
			[MaxChats:-1]
			[BroadcastRandomly:true]
			[Author:Fighter]
			[Color:Red]

			[ChatMessages: Returning to patrol pattern.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

			[ChatMessages:Target lost, beginning patrol.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

      </Description>
    </EntityComponent>
<!-- End Trigger to switch to patrol behavior -->

	</EntityComponents>
</Definitions>