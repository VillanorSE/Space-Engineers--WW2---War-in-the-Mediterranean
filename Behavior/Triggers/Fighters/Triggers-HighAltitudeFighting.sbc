<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- High Altitude Behavior Set -->
	<!-- Trigger when player is within 2000m -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-HighAltitudeFighting</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:2000]
			
			[Conditions:WW2-Condition-HighAltitudeFighting]
			
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-HighAltitudeFighting]
			
			</Description>
        </EntityComponent>

	<!-- Condition checking self Altitude -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Condition-HighAltitudeFighting</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Condition]
			
			[UseConditions:true]
			[AltitudeCheck:true]
			[MinAltitude:551]
			
			</Description>
        </EntityComponent>

	<!-- Change behavior to Fighter and autopilot to Secondary, disable high altitude trigger, enable low and patrol -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-HighAltitudeFighting</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]

			[ChangeBehaviorSubClass:true]
			[NewBehaviorSubclass:Fighter]
			
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			

			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-HighAltitudeFighting]

			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-LowAltitudeFighting]
			[EnableTriggerNames:WW2-Trigger-PatrolSwitch-Fighter]

			</Description>
        </EntityComponent>
<!-- End High Altitude Behaviors -->

	</EntityComponents>
</Definitions>