<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Trigger to switch to Fighter behavior when target within 6km -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-FighterSwitch-Fighter</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:6000]
			
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-FighterSwitch-Fighter]
			
			</Description>
        </EntityComponent>

	<!-- Action switches behavior to Fighter and secondary autopilot, turns on no target and patrol triggers, turns off fighter switch trigger -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-FighterSwitch-Fighter</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-FighterSwitch-Fighter]

			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Fighter]

			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]

			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-FighterSwitch-Fighter]

			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-PatrolSwitch-Fighter]
			[EnableTriggerNames:MES-Trigger-NoTargetRetreatInitialCheck]

			</Description>
        </EntityComponent>

	<!-- Broadcasts chat about engaging a target -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Chat-FighterSwitch-Fighter</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]

			[UseChat:true]
			[StartsReady:true]
			[MaxChats:-1]
			[BroadcastRandomly:true]
			[Author:Fighter]
			[Color:Red]

			[ChatMessages: Hostile approaching. Switching to engage.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

			[ChatMessages:Deviating from patrol to intercept hostile target.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

			</Description>
		</EntityComponent>
<!-- End Trigger to switch to Fighter behavior -->

	</EntityComponents>
</Definitions>