<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Low Altitude Behavior Set -->
	<!-- Trigger when target is within 2000m -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-LowAltitudeFighting</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:2000]
			
			[Conditions:WW2-Condition-LowAltitudeFighting]
			
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-LowAltitudeFighting]
			
			</Description>
        </EntityComponent>

	<!-- Condition checking self Altitude -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Condition-LowAltitudeFighting</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Condition]
			
			[UseConditions:true]
			[AltitudeCheck:true]
			[MinAltitude:0]
			[MaxAltitude:550]
			
			</Description>
        </EntityComponent>

	<!-- Change Autopilot to behavior to Strike and autopilot to tertiary disables low altitude trigger, enables high and PatrolSwitch -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-LowAltitudeFighting</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]

			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Strike]
			
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Tertiary]

			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-LowAltitudeFighting]

			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-HighAltitudeFighting]
			[EnableTriggerNames:WW2-Trigger-PatrolSwitch-Fighter]

			</Description>
        </EntityComponent>
<!-- End Low Altitude Behaviors -->

	</EntityComponents>
</Definitions>