<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Ship Destination -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-CargoShip-Destination</SubtypeId>
            </Id>
			<!-- Triggers when Ship receives a command broadcast -->
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:CommandReceived]
			[CommandReceiveCode:CargoShip-DestinationReceived]
			
			[StartsReady:true]
			[MaxActions:1]
            [Actions:WW2-Action-CargoShip-Destination]
			
			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-CargoShip-Destination</SubtypeId>
            </Id>
			<!-- Adds waypoint from command, Changes Autopilot -->
            <Description>	
			
			[RivalAI Action]
			
			[AddWaypointFromCommand:true]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-CargoShip-Destination]
			
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			
			</Description>			
        </EntityComponent>
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Chat-CargoShip-Destination</SubtypeId>
            </Id>
			<!-- Broadcasts chat with 3km range -->
            <Description>
			
			[RivalAI Chat]
			
			[UseChat:true]
			[StartsReady:true]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Cargo Ship Pilot]
			[Color:Red]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:3000]
			
			[ChatMessages: This is {AntennaName} requesting clearance for supply drop-off.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			
			[ChatMessages:{AntennaName} approaching the base.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			
			[ChatMessages:Special delivery coming in.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

			</Description>			
        </EntityComponent>
<!-- End Ship Destination -->

<!-- Destination Reached -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-CargoShip-DestinationReached</SubtypeId>
            </Id>
			<!-- Triggers when Ship despawns -->
            <Description>

			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:Despawn]
			[StartsReady:true]

			[MaxActions:1]
            [Actions:WW2-Action-CargoShip-DestinationReached]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-CargoShip-DestinationReached</SubtypeId>
            </Id>
			<!-- Activates a Command Profile -->
            <Description>			

			[RivalAI Action]
			
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:WW2-Command-CargoShip-DestinationReached]

			</Description>			
        </EntityComponent>
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Command-CargoShip-DestinationReached</SubtypeId>
            </Id>
			<!-- Broadcasts Command with 300m range -->
            <Description>			

			[RivalAI Command]
			
			[CommandCode:WW2-IHaveArrived]
			[SingleRecipient:true]
			[SendWaypoint:false]
			[MatchSenderReceiverOwners:true]
			[MaxRadius:300]

			</Description>			
        </EntityComponent>
<!-- End Destination Reached -->

	</EntityComponents>
</Definitions>