<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-TriggerGroup-Broadside</SubtypeId>
			</Id>
			<Description>

			[RivalAI TriggerGroup]

			[Triggers:WW2-Trigger-Broadside]
			[Triggers:WW2-Trigger-StartBroadside]
			[Triggers:WW2-Trigger-EndBroadside]

			</Description>

		</EntityComponent>
    
    <!--  Broadside  -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-Broadside</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]

			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:120000]
			[StartsReady:true]
        
			[MaxActions:-1]
			[ActionExecution:Sequential]
			[Actions:WW2-Action-BroadsideStarboard]
			[Actions:WW2-Action-BroadsidePort]

			</Description>

		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-BroadsideStarboard</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]

			[ChangeRotationDirection:true]
			[RotationDirection:Right]

			</Description>

		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-BroadsidePort</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]

			[ChangeRotationDirection:true]
			[RotationDirection:Left]

			</Description>

		</EntityComponent>
    
    <!--  StartBroadside  -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-StartBroadside</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:BehaviorTriggerA]
			[StartsReady:true]

			[MaxActions:-1]
			[Actions:WW2-Action-StartBroadside]

			</Description>

		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-StartBroadside</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]

			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-Broadside]
        
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerNames:WW2-Trigger-Broadside]
			[ForceManualTriggerActivation:true]

			</Description>

		</EntityComponent>

    <!--  EndBroadside  -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-EndBroadside</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:BehaviorTriggerB]
			[StartsReady:true]

			[MaxActions:-1]
			[Actions:WW2-Action-EndBroadside]

			</Description>

		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-EndBroadside</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
	
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-Broadside]
			[ChangeRotationDirection:true]
			[RotationDirection:Forward]
	
			</Description>

		</EntityComponent>

	</EntityComponents>
</Definitions>