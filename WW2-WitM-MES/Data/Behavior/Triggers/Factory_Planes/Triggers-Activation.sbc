<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Gray Factory Activation sequence -->
	<!-- Triggers when a player first approaches the factory within 800m -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Activation-Factory-Plane-Gray</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:800]
			[StartsReady:true]

			[MaxActions:1]
			
            [Actions:WW2-Action-Activation-Factory-Plane-Gray]
			
			</Description>
        </EntityComponent>

	<!-- Enables offensive plane spawn triggers and a chat message -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-Activation-Factory-Plane-Gray</SubtypeId>
            </Id>
			
            <Description>	
			
			[RivalAI Action]
			
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-OffenseSpawn-Factory-Plane-Re2000]
			[EnableTriggerNames:WW2-Trigger-OffenseSpawn-Factory-Plane-Re2001]
			[EnableTriggerNames:WW2-Trigger-OffenseSpawn-Factory-Plane-FC20]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-Factory-Activation]
			
			</Description>
        </EntityComponent>
<!-- End Gray Activation Actions -->

<!-- Green Activation Actions -->
	<!--Triggers when a player first approaches the factory within 800m-->	
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Activation-Factory-Plane-Green</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:800]
			[StartsReady:true]

			[MaxActions:1]
			
            [Actions:WW2-Action-Activation-Factory-Plane-Green]
			
			</Description>
        </EntityComponent>

	<!--Enables offensive plane spawn triggers and a chat message-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-Activation-Factory-Plane-Green</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]
			
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-OffenseSpawn-Factory-Plane-MS406]
			
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-OffenseSpawn-Factory-Plane-Potez630]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-Factory-Activation]
			
			</Description>
        </EntityComponent>
<!-- End Green Activation Actions -->
	
<!-- Chat for both Activations -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Chat-Factory-Activation</SubtypeId>
            </Id>
			<!--Chats declaration 10km, of production beginning-->
            <Description>
			
			[RivalAI Chat]
			
			[UseChat:true]
            [StartsReady:true]
            [BroadcastRandomly:true]
			[Author:{GridName}]
			[Color:Blue]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]

            [ChatMessages:Surrounding area is populated, beginning routine patrol procedures!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]
			
			</Description>
        </EntityComponent>
<!-- End Chat for both Activations -->

	</EntityComponents>
</Definitions>