<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Disable Engine sequence, FC20 -->
	<!-- Fires once shortly after spawn, mirroring WW2-Trigger-UnStatic's timing.
	     Needed because the shared WW2-SpawnConditions-Installations profile sets
	     [ReplenishSystems:true], which appears to re-enable power-related blocks
	     (including these two named Hydrogen Engines) even though the exported
	     Player-WW2-FC20 blueprint has them saved as Enabled=false. Forcing them
	     off again post-spawn works regardless of the exact re-enable mechanism.
	     Block names ("Radial Engine Left"/"Radial Engine Right") are the actual
	     CustomName values baked into Player-WW2-FC20.sbc.
	     [EnableBlocks]/[EnableBlockNames]/[EnableBlockStates] syntax per MES
	     Action wiki — inferred from the wiki's description, not yet confirmed
	     working in this project; flag if it doesn't take effect. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DisableEngine-FC20</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:Timer]

			[MinCooldownMs:1200]
			[MaxCooldownMs:1500]
			[StartsReady:true]

			[MaxActions:1]
			[Actions:WW2-Action-DisableEngine-FC20]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DisableEngine-FC20</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[EnableBlocks:true]
			[EnableBlockNames:Radial Engine Left]
			[EnableBlockNames:Radial Engine Right]
			[EnableBlockStates:Off]

			</Description>
        </EntityComponent>
<!-- End Disable Engine sequence, FC20 -->

	</EntityComponents>
</Definitions>
