<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Factions>
  
    <Faction Tag="GRAY" Founder="The Dictator">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>WW2-Gray</SubtypeId>
      </Id>
      <DisplayName>The Gray</DisplayName>
	  <Description>The Gray are an alliance of several entities intent on expanding their territory for the exclusive benefit of their people. Their methods are often violent however not all factions have been drawn into their wars yet.</Description>
      <IsDefault>true</IsDefault>
	  <DefaultRelation>Enemies</DefaultRelation>
	  <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>

    </Faction>
	
	<Faction Tag="GREEN" Founder="The Statesman">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>WW2-Green</SubtypeId>
      </Id>
      <DisplayName>The Green</DisplayName>
	  <Description>The Green are an alliance of numerous entities intent on containing The Gray. They are prepared to fight any who fight them.</Description>
      <IsDefault>true</IsDefault>
	  <DefaultRelation>Enemies</DefaultRelation>
	  <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>
	  
    </Faction>
	
  </Factions>
</Definitions>