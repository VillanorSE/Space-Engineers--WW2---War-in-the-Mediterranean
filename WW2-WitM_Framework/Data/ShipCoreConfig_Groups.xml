  <!-- HydrogenTanks: small tanks weight 1, large tanks weight 6.
       SubtypeIds below are best-recollection vanilla naming, NOT independently
       verified — small/large grid each have small and large tank variants, and
       exact strings have some historical inconsistency in vanilla SE. Confirm
       against actual game files before relying on this group. Note the practical
       consequence of the 1/6 weighting: at low MaxCount values (2-4 range), large
       tanks are effectively locked out entirely (6 > MaxCount), leaving only small
       tanks usable at Corvette/Civilian tier — flagging in case that's not intended. -->
  <BlockGroup>
    <Name>HydrogenTanks</Name>
    <BlockTypes>
      <TypeId>OxygenTank</TypeId>
      <SubtypeId>LargeHydrogenTankSmall</SubtypeId>
      <CountWeight>1</CountWeight>
    </BlockTypes>
    <BlockTypes>
      <TypeId>OxygenTank</TypeId>
      <SubtypeId>SmallHydrogenTankSmall</SubtypeId>
      <CountWeight>1</CountWeight>
    </BlockTypes>
    <BlockTypes>
      <TypeId>OxygenTank</TypeId>
      <SubtypeId>LargeHydrogenTank</SubtypeId>
      <CountWeight>6</CountWeight>
    </BlockTypes>
    <BlockTypes>
      <TypeId>OxygenTank</TypeId>
      <SubtypeId>SmallHydrogenTank</SubtypeId>
      <CountWeight>6</CountWeight>
    </BlockTypes>
  </BlockGroup>

