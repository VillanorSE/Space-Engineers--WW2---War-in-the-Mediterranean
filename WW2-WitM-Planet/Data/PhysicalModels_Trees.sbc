  </Definition>

  <!-- NEW, not from the source mod; see file header note -->
  <Definition xsi:type="MyObjectBuilder_TreeDefinition">
    <Id>
      <TypeId>TreeDefinition</TypeId>
      <SubtypeId>DesertTree</SubtypeId>
    </Id>
