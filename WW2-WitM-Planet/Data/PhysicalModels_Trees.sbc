  <Definition xsi:type="MyObjectBuilder_TreeDefinition">
    <Id>
      <TypeId>TreeDefinition</TypeId>
      <SubtypeId>AlvaniaLeafTree</SubtypeId>
    </Id>
    <Model>Models\Environment\Trees\AlvaniaLeafTree\AlvaniaLeafTree.mwm</Model>
    <BranchesStartHeight>2.342</BranchesStartHeight>
    <PhysicalMaterial>Tree</PhysicalMaterial>
    <HitPoints>50</HitPoints>
    <CutEffect>ChipOff_Wood</CutEffect>
    <FallSound>ImpTreeFall</FallSound>
    <BreakSound>ImpTreeBreak</BreakSound>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_TreeDefinition">
    <Id>
      <TypeId>TreeDefinition</TypeId>
      <SubtypeId>AlvaniaLeafTreeMedium</SubtypeId>
    </Id>
    <Model>Models\Environment\Trees\AlvaniaLeafTree\AlvaniaLeafTreeMedium.mwm</Model>
